# fix-my-fnos 配置文件范例

# 应用启动时将等待 Docker 服务正常后再继续，否则会退出。如未配置则使用默认值。
[startup]
# 应用启动时等待 Docker 服务的超时时间（秒）
# 默认值: 300
# startup_timeout = 300

# 应用启动时检测 Docker 服务的间隔时间（秒），即：每隔多少秒检查一次 Docker 是否可用。
# 默认值: 30
# startup_interval = 30

# 应用启动后，将尝试启动指定的 Docker compose 项目。
[compose]
# 项目目录列表。每个目录应该包含 docker-compose.yml。示例：
# directories = [
#     "/vol1/1000/Workspace/traefik",
#     "/vol1/1000/Workspace/homepage",
#     "/vol1/1000/Workspace/openspeedtest",
# ]
#
directories = []
# 执行命令示例：
# docker compose --project-directory <directory> up -d

# 应用运行中，将监听指定网卡，在检测到网卡状态变化并恢复 UP 时，检查并尝试恢复 macvlan 网络。
[macvlan]

# 要监听的主机物理网卡（必填）。示例：
# interface = "bond1"
interface = ""

# macvlan 代理网卡名称。宿主机侧创建的 macvlan interface，用于访问 Docker macvlan 网络中的设备。
# 默认值: macvlan-proxy
# proxy_interface = "macvlan-proxy"

# macvlan 代理网卡 IP 地址及网段（必填）。示例:
# proxy_cidr = "192.168.1.4/32"
proxy_cidr = ""

# 使用 macvlan 网络的 Docker 容器名称。应用将尝试测试该容器是否能 ping 通局域网网关，否则将重启该容器。
# 默认值: qwrt
# container_name = "qwrt"

# 使用 macvlan 网络的 Docker 容器固定 IP（必填）。应用会添加对应路由，使宿主机可以通过 proxy_interface 访问该容器。示例:
# container_ip = "192.168.1.3"
container_ip = ""

# 局域网网关 IP，用于测试网络联通状态（必填）。示例:
# gateway_ip = "192.168.1.1"
gateway_ip = ""
